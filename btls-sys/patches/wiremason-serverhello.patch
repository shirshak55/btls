diff --git a/ssl/tls13_server.cc b/ssl/tls13_server.cc
index 4dabd57..b37b104 100644
--- a/ssl/tls13_server.cc
+++ b/ssl/tls13_server.cc
@@ -134,6 +134,48 @@ static int ssl_ext_supported_versions_add_serverhello(SSL_HANDSHAKE *hs,
   return 1;
 }
 
+// add_tls13_server_hello_extensions writes the TLS 1.3 ServerHello's
+// extensions: pre_shared_key, pake, key_share and supported_versions, each when
+// the negotiation calls for it, in the order |SSL_CTX_set_server_extension_order|
+// lists them, any not listed after them in the default order.
+static bool add_tls13_server_hello_extensions(SSL_HANDSHAKE *hs, CBB *out) {
+  using Writer = bool (*)(SSL_HANDSHAKE *, CBB *);
+  struct Entry {
+    uint16_t id;
+    Writer write;
+  };
+  const Entry kDefault[] = {
+      {TLSEXT_TYPE_pre_shared_key, ssl_ext_pre_shared_key_add_serverhello},
+      {TLSEXT_TYPE_pake, ssl_ext_pake_add_serverhello},
+      {TLSEXT_TYPE_key_share, ssl_ext_key_share_add_serverhello},
+      {TLSEXT_TYPE_supported_versions,
+       [](SSL_HANDSHAKE *h, CBB *c) -> bool {
+         return ssl_ext_supported_versions_add_serverhello(h, c);
+       }},
+  };
+  constexpr size_t kNum = sizeof(kDefault) / sizeof(kDefault[0]);
+  bool done[kNum] = {false};
+  for (uint16_t id : hs->config->server_extension_order) {
+    for (size_t i = 0; i < kNum; i++) {
+      if (!done[i] && kDefault[i].id == id) {
+        done[i] = true;
+        if (!kDefault[i].write(hs, out)) {
+          return false;
+        }
+        break;
+      }
+    }
+  }
+  // The ServerHello's extensions are all required by the negotiation, so the
+  // unlisted ones always follow, even with a strict order.
+  for (size_t i = 0; i < kNum; i++) {
+    if (!done[i] && !kDefault[i].write(hs, out)) {
+      return false;
+    }
+  }
+  return true;
+}
