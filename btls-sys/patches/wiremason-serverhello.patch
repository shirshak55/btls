+// SSL_CTX_set_server_extension_order sets the order in which a server on |ctx|
+// writes the extensions of its ServerHello and EncryptedExtensions: the
+// implemented extensions whose id appears in |ids| are written in that order,
+// each only when the negotiation calls for it; any implemented extension not
+// listed follows in the library's default order unless a strict order is set
+// (see |SSL_CTX_set_strict_server_extension_order|). It is the server-side
+// analogue of |SSL_CTX_set_extension_order|.
+OPENSSL_EXPORT int SSL_CTX_set_server_extension_order(SSL_CTX *ctx,
+                                                      const uint16_t *ids,
+                                                      size_t num_ids);
+
+// SSL_CTX_set_strict_server_extension_order configures whether the order set
+// with |SSL_CTX_set_server_extension_order| is the whole list: only the listed
+// extensions are written (still only those the negotiation calls for), and no
+// others; an unlisted extended_master_secret, session_ticket, status_request or
+// ALPN extension is then not negotiated either. The TLS 1.3 ServerHello's own
+// extensions (pre_shared_key, key_share, supported_versions) are always sent.
+OPENSSL_EXPORT void SSL_CTX_set_strict_server_extension_order(SSL_CTX *ctx,
+                                                             int enabled);
+
+// SSL_CTX_set_ticket_nonce_length sets the length, in bytes, of the
+// ticket_nonce a server on |ctx| writes in each TLS 1.3 NewSessionTicket: the
+// ticket's index as a big-endian integer of |len| bytes (1 to 255; the default
+// is 1). Lets a server reproduce another implementation's nonce shape. It
+// returns one on success and zero if |len| is out of range.
+OPENSSL_EXPORT int SSL_CTX_set_ticket_nonce_length(SSL_CTX *ctx, size_t len);
+
+// SSL_CTX_set_ticket_grease_extension configures whether a server on |ctx|
+// adds a GREASE extension (RFC 8701) to each TLS 1.3 NewSessionTicket. It is
+// enabled by default.
+OPENSSL_EXPORT void SSL_CTX_set_ticket_grease_extension(SSL_CTX *ctx,
+                                                        int enabled);
+
+// SSL_set_pending_application_settings replaces, on a client mid-handshake that
+// has negotiated ALPS (its EncryptedExtensions not yet sent, as during a custom
+// verification callback returning |ssl_verify_retry|), the settings it will send
+// with |settings|, instead of those |SSL_add_application_settings| configured.
+// It returns one on success and zero when ALPS is not negotiated or the
+// handshake is not at such a point.
+OPENSSL_EXPORT int SSL_set_pending_application_settings(SSL *ssl,
+                                                        const uint8_t *settings,
+                                                        size_t settings_len);
+
