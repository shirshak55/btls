diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 91fc13a..f257cfc 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -2411,6 +2411,16 @@ void SSL_set_custom_verify(
   ssl->config->custom_verify_callback = callback;
 }
 
+int SSL_set1_certificate_request(SSL *ssl, uint16_t version,
+                                 const uint8_t *body, size_t body_len) {
+  if (!ssl->config || version == 0 ||
+      !ssl->config->certificate_request.CopyFrom(Span(body, body_len))) {
+    return 0;
+  }
+  ssl->config->certificate_request_version = version;
+  return 1;
+}
+
 void SSL_CTX_enable_signed_cert_timestamps(SSL_CTX *ctx) {
   ctx->signed_cert_timestamps_enabled = true;
 }
