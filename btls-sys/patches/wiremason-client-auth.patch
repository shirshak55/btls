     enum ssl_verify_result_t (*callback)(SSL *ssl, uint8_t *out_alert));
 
+// SSL_set1_certificate_request configures |ssl|, a server requesting a client
+// certificate (|SSL_VERIFY_PEER|), to send |body| verbatim as the body of its
+// CertificateRequest in a handshake negotiating |version|, such as the request
+// of an origin a proxy mirrors, and its own in a handshake negotiating another.
+// Its custom verify callback (see |SSL_set_custom_verify|) then runs on the
+// client's Certificate whether or not it carries a certificate, so that the
+// caller decides on an empty one too. It returns one on success and zero on
+// error.
+OPENSSL_EXPORT int SSL_set1_certificate_request(SSL *ssl, uint16_t version,
+                                                const uint8_t *body,
+                                                size_t body_len);
+
 // SSL_CTX_get_verify_mode returns |ctx|'s verify mode, set by
 // |SSL_CTX_set_verify|.
 OPENSSL_EXPORT int SSL_CTX_get_verify_mode(const SSL_CTX *ctx);
