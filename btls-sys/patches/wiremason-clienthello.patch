+bool ssl_cert_allows_delegation(const CBS *in, int64_t *out_not_before) {
+  CBS buf = *in, toplevel, tbs_cert, validity, not_before, outer_extensions,
+      extensions;
+  int has_extensions;
+  if (!CBS_get_asn1(&buf, &toplevel, CBS_ASN1_SEQUENCE) ||         //
+      CBS_len(&buf) != 0 ||                                        //
+      !CBS_get_asn1(&toplevel, &tbs_cert, CBS_ASN1_SEQUENCE) ||   //
+      !CBS_get_optional_asn1(
+          &tbs_cert, nullptr, nullptr,
+          CBS_ASN1_CONSTRUCTED | CBS_ASN1_CONTEXT_SPECIFIC | 0) ||  //
+      !CBS_get_asn1(&tbs_cert, nullptr, CBS_ASN1_INTEGER) ||       //
+      !CBS_get_asn1(&tbs_cert, nullptr, CBS_ASN1_SEQUENCE) ||      //
+      !CBS_get_asn1(&tbs_cert, nullptr, CBS_ASN1_SEQUENCE) ||      //
+      !CBS_get_asn1(&tbs_cert, &validity, CBS_ASN1_SEQUENCE) ||    //
+      !CBS_get_asn1(&tbs_cert, nullptr, CBS_ASN1_SEQUENCE) ||      //
+      !CBS_get_asn1(&tbs_cert, nullptr, CBS_ASN1_SEQUENCE) ||      //
+      !CBS_get_optional_asn1(&tbs_cert, nullptr, nullptr,
+                             CBS_ASN1_CONTEXT_SPECIFIC | 1) ||
+      !CBS_get_optional_asn1(&tbs_cert, nullptr, nullptr,
+                             CBS_ASN1_CONTEXT_SPECIFIC | 2) ||
+      !CBS_get_optional_asn1(
+          &tbs_cert, &outer_extensions, &has_extensions,
+          CBS_ASN1_CONSTRUCTED | CBS_ASN1_CONTEXT_SPECIFIC | 3) ||
+      !has_extensions ||
+      !CBS_get_asn1(&outer_extensions, &extensions, CBS_ASN1_SEQUENCE)) {
+    return false;
+  }
+
+  struct tm tm;
+  time_t not_before_time;
+  if (!(CBS_get_asn1(&validity, &not_before, CBS_ASN1_UTCTIME)
+            ? CBS_parse_utc_time(&not_before, &tm, /*allow_timezone_offset=*/0)
+            : CBS_get_asn1(&validity, &not_before,
+                           CBS_ASN1_GENERALIZEDTIME) &&
+                  CBS_parse_generalized_time(&not_before, &tm,
+                                             /*allow_timezone_offset=*/0)) ||
+      !OPENSSL_timegm(&tm, &not_before_time)) {
+    return false;
+  }
+
+  // id-ce-keyUsage and id-pe-delegationUsage (1.3.6.1.4.1.44363.44).
+  static const uint8_t kKeyUsageOID[] = {0x55, 0x1d, 0x0f};
+  static const uint8_t kDelegationUsageOID[] = {0x2b, 0x06, 0x01, 0x04, 0x01,
+                                                0x82, 0xda, 0x4b, 0x2c};
+  bool digital_signature = false, delegation_usage = false;
+  while (CBS_len(&extensions) > 0) {
+    CBS extension, oid, contents;
+    if (!CBS_get_asn1(&extensions, &extension, CBS_ASN1_SEQUENCE) ||
+        !CBS_get_asn1(&extension, &oid, CBS_ASN1_OBJECT) ||
+        (CBS_peek_asn1_tag(&extension, CBS_ASN1_BOOLEAN) &&
+         !CBS_get_asn1(&extension, nullptr, CBS_ASN1_BOOLEAN)) ||
+        !CBS_get_asn1(&extension, &contents, CBS_ASN1_OCTETSTRING) ||
+        CBS_len(&extension) != 0) {
+      return false;
+    }
+    if (CBS_mem_equal(&oid, kDelegationUsageOID,
+                      sizeof(kDelegationUsageOID))) {
+      delegation_usage = true;
+    } else if (CBS_mem_equal(&oid, kKeyUsageOID, sizeof(kKeyUsageOID))) {
+      CBS bit_string;
+      if (!CBS_get_asn1(&contents, &bit_string, CBS_ASN1_BITSTRING) ||
+          CBS_len(&contents) != 0 ||
+          !CBS_is_valid_asn1_bitstring(&bit_string)) {
+        return false;
+      }
+      digital_signature = CBS_asn1_bitstring_has_bit(
+          &bit_string, key_usage_digital_signature);
+    }
+  }
+
+  *out_not_before = not_before_time;
+  return digital_signature && delegation_usage;
+}
