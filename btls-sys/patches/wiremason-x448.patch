+
+// X448.
+//
+// X448 is the Diffie-Hellman primitive built from Curve448. See
+// https://tools.ietf.org/html/rfc7748. This implementation is OpenSSL's
+// (crypto/ec/curve448).
+
+#define X448_PRIVATE_KEY_LEN 56
+#define X448_PUBLIC_VALUE_LEN 56
+#define X448_SHARED_KEY_LEN 56
+
+// X448_keypair sets |out_public_value| and |out_private_key| to a freshly
+// generated, public–private key pair.
+OPENSSL_EXPORT void X448_keypair(uint8_t out_public_value[56],
+                                 uint8_t out_private_key[56]);
+
+// X448 writes a shared key to |out_shared_key| that is calculated from the
+// given private key and the peer's public value. It returns one on success and
+// zero on error (an all-zero shared key, from a point of small order).
+OPENSSL_EXPORT int X448(uint8_t out_shared_key[56],
+                        const uint8_t private_key[56],
+                        const uint8_t peer_public_value[56]);
+
+// X448_public_from_private calculates a Diffie-Hellman public value from the
+// given private key and writes it to |out_public_value|.
+OPENSSL_EXPORT void X448_public_from_private(uint8_t out_public_value[56],
+                                             const uint8_t private_key[56]);
+
+
+#if defined(__cplusplus)
+}  // extern C
+#endif
+
+#endif  // OPENSSL_HEADER_CURVE448_H
