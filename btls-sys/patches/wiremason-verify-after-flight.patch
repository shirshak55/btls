+// new_traffic_aead returns an AEAD context for |direction| with the keys of
+// |traffic_secret|, under |session|'s version and cipher suite.
+static UniquePtr<SSLAEADContext> new_traffic_aead(
+    enum evp_aead_direction_t direction, const SSL_SESSION *session,
+    Span<const uint8_t> traffic_secret, bool is_dtls) {
+  // Look up cipher suite properties.
+  const EVP_AEAD *aead;
+  size_t discard;
+  if (!ssl_cipher_get_evp_aead(&aead, &discard, &discard, session->cipher,
+                               ssl_session_protocol_version(session))) {
+    return nullptr;
+  }
+
+  // Derive the key and IV.
+  const EVP_MD *digest = ssl_session_get_digest(session);
+  uint8_t key_buf[EVP_AEAD_MAX_KEY_LENGTH], iv_buf[EVP_AEAD_MAX_NONCE_LENGTH];
+  auto key = Span(key_buf).first(EVP_AEAD_key_length(aead));
+  auto iv = Span(iv_buf).first(EVP_AEAD_nonce_length(aead));
+  if (!hkdf_expand_label(key, digest, traffic_secret, "key", {}, is_dtls) ||
+      !hkdf_expand_label(iv, digest, traffic_secret, "iv", {}, is_dtls)) {
+    return nullptr;
+  }
+
+  return SSLAEADContext::Create(direction, session->ssl_version,
+                                session->cipher, key, {}, iv);
+}
+
+UniquePtr<SSLAEADContext> tls13_server_application_aead(
+    const SSL_HANDSHAKE *hs) {
+  if (hs->new_session == nullptr || hs->server_traffic_secret_0.empty() ||
+      SSL_is_quic(hs->ssl)) {
