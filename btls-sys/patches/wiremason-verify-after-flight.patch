+// SSL_set_verify_after_server_flight configures |ssl|, a client, to verify the
+// server's certificate once it has read the server's whole flight, through its
+// ServerHelloDone (TLS 1.2) or Finished (TLS 1.3), rather than right after its
+// Certificate, so that a custom verify callback (see |SSL_set_custom_verify|)
+// pausing the handshake (|ssl_verify_retry|) finds its ServerKeyExchange and
+// CertificateRequest read, and the handshake paused where every other pause
+// after the server's flight is (see |SSL_peek_server_alert|). The client sends
+// nothing before then either way. It returns one on success and zero if
+// |ssl|'s configuration was shed.
+OPENSSL_EXPORT int SSL_set_verify_after_server_flight(SSL *ssl, int enabled);
+
+// SSL_peek_server_alert looks through |in_len| bytes at |in| that the server
+// sent |ssl|, a client whose handshake is paused after the server's whole
+// flight (see |SSL_set_verify_after_server_flight| and |SSL_CTX_set_cert_cb|),
+// read from its transport since and not yet given to it, for the alert the
+// server ended the handshake with meanwhile, leaving |ssl| as it is. TLS 1.3
+// records are opened with the server's application traffic keys, which a
+// server uses from its Finished on; handshake messages before the alert (a
+// NewSessionTicket) are skipped. It returns one and sets |*out_level| and
+// |*out_desc| when the first other record is an alert, zero when no other
+// record is whole in |in| yet, and -1 when it is something else (application
+// data), a record can't be opened, or |ssl| isn't so paused, so that none of
+// the server's alerts can be told.
+OPENSSL_EXPORT int SSL_peek_server_alert(const SSL *ssl, const uint8_t *in,
+                                         size_t in_len, uint8_t *out_level,
+                                         uint8_t *out_desc);
+
