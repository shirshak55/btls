+int SSL_set_verify_after_server_flight(SSL *ssl, int enabled) {
+  if (!ssl->config) {
+    return 0;
+  }
+  ssl->config->verify_after_server_flight = !!enabled;
+  return 1;
+}
+
+int SSL_peek_server_alert(const SSL *ssl, const uint8_t *in, size_t in_len,
+                          uint8_t *out_level, uint8_t *out_desc) {
+  const SSL_HANDSHAKE *hs = ssl->s3->hs.get();
+  if (ssl->server || hs == nullptr || SSL_is_dtls(ssl) || SSL_is_quic(ssl)) {
+    return -1;
+  }
+  // A TLS 1.3 server's records past its Finished are under its application
+  // traffic keys; a TLS 1.2 server's before its ChangeCipherSpec, in the clear.
+  UniquePtr<SSLAEADContext> aead;
+  if (ssl_protocol_version(ssl) >= TLS1_3_VERSION) {
+    aead = tls13_server_application_aead(hs);
+    if (aead == nullptr) {
+      return -1;
+    }
+  } else if (!ssl->s3->aead_read_ctx->is_null_cipher()) {
+    return -1;
+  }
+  CBS records(Span(in, in_len));
+  for (uint64_t seqnum = 0;; seqnum++) {
+    CBS header = records, body;
+    uint8_t type;
+    uint16_t version, len;
+    if (!CBS_get_u8(&records, &type) || !CBS_get_u16(&records, &version) ||
+        !CBS_get_u16(&records, &len)) {
+      return 0;
+    }
+    if (len > SSL3_RT_MAX_ENCRYPTED_LENGTH) {
+      return -1;
+    }
+    if (!CBS_get_bytes(&records, &body, len)) {
+      return 0;
+    }
+    Array<uint8_t> opened;
+    Span<const uint8_t> plaintext = body;
+    if (aead != nullptr) {
+      Span<uint8_t> out;
+      if (type != SSL3_RT_APPLICATION_DATA || !opened.CopyFrom(body) ||
+          !aead->Open(&out, type, version, seqnum,
+                      Span(CBS_data(&header), SSL3_RT_HEADER_LENGTH),
+                      Span(opened))) {
+        return -1;
+      }
+      // The inner content type follows the content, then any zero padding.
+      while (!out.empty() && out.back() == 0) {
+        out = out.first(out.size() - 1);
+      }
+      if (out.empty()) {
+        return -1;
+      }
+      type = out.back();
+      plaintext = out.first(out.size() - 1);
+    }
+    if (type == SSL3_RT_ALERT && plaintext.size() == 2) {
+      *out_level = plaintext[0];
+      *out_desc = plaintext[1];
+      return 1;
+    }
+    if (type != SSL3_RT_HANDSHAKE) {
+      return -1;
+    }
+  }
+}
